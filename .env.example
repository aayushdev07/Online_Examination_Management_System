# ---------------------------------------------------------------------------
# OEMS configuration. Copy to .env (same folder) and fill in the passwords.
# .env is read by the backend and by backend/scripts/init_db.py.
# Never commit .env — it contains credentials.
# ---------------------------------------------------------------------------

APP_ENV=development
LOG_LEVEL=INFO

# MySQL server (8.0.16 or later)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=oems_db
LAB_DB_NAME=oems_lab
# Host part of the MySQL accounts that init_db.py creates.
# Use % if you get "Access denied" for TCP connections from 127.0.0.1.
DB_ACCOUNT_HOST=localhost

# Administrator — used ONLY by scripts/init_db.py and the test suite, never by the API
MYSQL_ADMIN_USER=root
MYSQL_ADMIN_PASSWORD=

# Least-privilege accounts used by the API (init_db.py creates them with these passwords)
DB_APP_USER=oems_app
DB_APP_PASSWORD=ChangeMe_App_2026
DB_READONLY_USER=oems_reader
DB_READONLY_PASSWORD=ChangeMe_Reader_2026
DB_LAB_USER=oems_lab
DB_LAB_PASSWORD=ChangeMe_Lab_2026
DB_DCL_USER=oems_lab_dcl
DB_DCL_PASSWORD=ChangeMe_Dcl_2026

# Authentication — use a long random value (python -c "import secrets;print(secrets.token_hex(32))")
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE_MINUTES=240

# Browser origins allowed to call the API directly (the Vite dev server proxies /api anyway)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# DBMS lab
SQL_FREEFORM_ENABLED=true
SQL_MAX_ROWS=500
SQL_TIMEOUT_SECONDS=10
SQL_RATE_LIMIT_PER_MINUTE=30
LOGIN_RATE_LIMIT_PER_MINUTE=10

# Synthetic data volume (students generated in addition to the 12 named ones)
BULK_STUDENTS=3000
LAB_BULK_STUDENTS=1500

# Queries slower than this (ms) appear on the Performance dashboard
SLOW_QUERY_MS=200
